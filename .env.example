# Copy to .env.local for development. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form — Resend (https://resend.com) + Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Automated tests never use these: Playwright/Lighthouse inject Cloudflare's test keys and an empty Resend key.
RESEND_API_KEY=
CONTACT_TO=connect@raheelqureshi.com
CONTACT_FROM=Raheel Qureshi <connect@raheelqureshi.com>
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Database — every form submission is stored in Supabase Postgres (Project Settings → API).
# The server prefers the service role key (never sent to the browser); the anon key also works (insert-only via RLS).
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` (Supabase → Connect → Session pooler URI with the DB password); never used at runtime
DATABASE_URL=

# Booking
NEXT_PUBLIC_CAL_LINK=

# Analytics (GA4 loads only after consent; Cloudflare beacon is cookieless and always loads)
NEXT_PUBLIC_GA_ID= # GA4 *measurement ID* (G-XXXXXXXXXX) from Admin → Data streams → Web, not the numeric property/stream id
NEXT_PUBLIC_CF_BEACON_TOKEN=
NEXT_PUBLIC_BING_VERIFICATION=

# Feature flags
NEXT_PUBLIC_FLAG_CURSOR=false
