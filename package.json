    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:e2e": "node scripts/lighthouse.mts --build-only && playwright test",
    "lhci": "node scripts/lighthouse.mts --build",
    "db:migrate": "node scripts/db-migrate.mts"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@next/third-parties": "^16.3.4",
    "@supabase/supabase-js": "^2.115.0",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "lighthouse": "^13.4.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
